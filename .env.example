# ---- Docker Compose (docker/docker-compose.yml) ----
# Non-default port: 5432 is already used by other local projects on this machine.
POSTGRES_USER=eaglehr
POSTGRES_PASSWORD=eaglehr_dev_password
POSTGRES_DB=eaglehr
POSTGRES_PORT=5442

# ---- packages/db/.env (Prisma) ----
DATABASE_URL="postgresql://eaglehr:eaglehr_dev_password@localhost:5442/eaglehr?schema=public"

# ---- apps/api/.env ----
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
WEB_APP_URL=http://localhost:3000

JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_BASE_URL=https://api.paystack.co

# Leave unset in dev to skip sending (invitation links are logged instead).
RESEND_API_KEY=
MAIL_FROM="EagleHR <no-reply@eaglehr.ng>"

# ---- apps/web/.env.local ----
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
COOKIE_DOMAIN=localhost

# ---- apps/desktop (bundled config, not auto-loaded by Rust) ----
APP_URL=http://localhost:3000

# ---- Railway ----
# The Postgres plugin auto-injects DATABASE_URL into the api service — no
# need to set it by hand. Railway also injects PORT; api's main.ts reads it
# automatically. Everything else below is set per-service
# as plain Railway variables (editable anytime in the dashboard):
#
# api service:
#   CORS_ORIGIN=https://<web-service-domain>
#   WEB_APP_URL=https://<web-service-domain>
#   API_PUBLIC_URL=https://<api-service-domain>
#   JWT_ACCESS_SECRET / JWT_REFRESH_SECRET  (generate fresh secrets, don't reuse dev)
#   PAYSTACK_PUBLIC_KEY / PAYSTACK_SECRET_KEY / PAYSTACK_BASE_URL
#   RESEND_API_KEY / MAIL_FROM
#
# web service:
#   NEXT_PUBLIC_API_URL=https://<api-service-domain>
#   API_INTERNAL_URL=https://<api-service-domain>   (or a private network URL if both services are in one Railway project)
#   COOKIE_SECURE=true
