{
  "name": "eaglehr",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @eaglehr/db migrate",
    "db:migrate:deploy": "pnpm --filter @eaglehr/db migrate:deploy",
    "db:studio": "pnpm --filter @eaglehr/db studio",
    "db:seed": "pnpm --filter @eaglehr/db seed",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "eslint": "9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
